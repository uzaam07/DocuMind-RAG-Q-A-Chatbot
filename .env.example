# Copy to .env and edit. Never commit .env.

# --- AI provider: Google Gemini Developer API (free tier) ------------------
# Create a key at https://aistudio.google.com/apikey
# Free-tier quotas and model availability are controlled by Google and may change.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Embeddings run locally on your machine/server; no embedding API key or API fee.
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# true = deterministic offline mock mode (no Gemini calls).
MOCK_LLM=false
# Changing LOCAL_EMBEDDING_MODEL creates a separate Chroma collection.
# Re-index documents to use a new embedding model.

# --- Auth ------------------------------------------------------------------
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
# bcrypt cost factor (4-15). Higher is slower and safer.
BCRYPT_ROUNDS=12

# --- Retrieval -------------------------------------------------------------
# Target characters per chunk and overlap between neighbouring chunks.
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# How many chunks are passed to the model.
TOP_K=5
# vector | hybrid | hybrid_rerank  (default for requests that do not pick a mode)
RETRIEVAL_MODE=hybrid
# Minimum cosine similarity (vector, hybrid). Leave empty for 0.25 (Gemini/local) / 0.12 (mock).
SCORE_THRESHOLD=
# Minimum rerank score on a 0..1 scale (hybrid_rerank).
RERANK_THRESHOLD=0.3

# --- Limits and caching ----------------------------------------------------
MAX_UPLOAD_MB=20
# Answer cache lifetime in seconds (default 24 h).
CACHE_TTL_SECONDS=86400

# --- Server ----------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# SQLite, Chroma and uploads live here. Relative paths resolve from backend/.
DATA_DIR=./data
# Where the in-app Stats page looks for eval results, and where sample docs live.
EVAL_RESULTS_PATH=../eval/results/results.json
SAMPLE_DOCS_DIR=../eval/sample_docs

# Optional SQLAlchemy URL (PostgreSQL recommended for multi-instance deployments)
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/documind

# Optional Redis URL enables durable RQ ingestion jobs
# REDIS_URL=redis://localhost:6379/0
